# 복사 후 `.env` 로 저장해 사용하세요. 실제 값은 커밋하지 마세요.
# GitHub Actions: Repository secrets에 동일 이름으로 등록 (prod / PR 미리보기 빌드용)

# 백엔드 API 베이스 URL (끝에 슬래시 여부는 코드와 맞출 것)
VITE_API_BASE_URL=https://example.com/

# 카카오 지도 JavaScript 키 (문의 페이지 지도)
VITE_KAKAO_API=

# EmailJS (문의 폼, 자원봉사 모달 등)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
# 자원봉사 등 별도 템플릿을 쓰는 경우
VITE_EMAILJS_TEMPLATE_ID_VOLUNTEER=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_TO_EMAIL=

# 아래는 GitHub Actions deploy.yml에만 있고, 실제 src 코드에서는 미사용일 수 있음.
# 필요 없으면 워크플로에서 제거해도 됨.
# VITE_JWT_SECRET=
